includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - scripts
        - examples/plain-php
    scanFiles:
        - tests/Fixtures/portal/verificar-firma.php
    excludePaths:
        # A verbatim copy of the portal snippet, compared against the SDK in the tests.
        - tests/Fixtures/portal/verificar-firma.php
    # The resources are created in the client's constructor through this generated method.
    additionalConstructors:
        - Funnelchat\Funnelchat::initResources
    tmpDir: .phpstan.cache
