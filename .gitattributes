* text=auto eol=lf

# What the Composer package does not need (it ships src/, the README and composer.json).
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/examples export-ignore
/scripts export-ignore
/spec export-ignore
/tests export-ignore

# Generated from spec/: collapsed in diffs.
/src/Generated/** linguist-generated=true
/src/Resources/** linguist-generated=true
/spec/funnelchat.json linguist-generated=true
