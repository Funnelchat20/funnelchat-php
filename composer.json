{
    "name": "funnelchat/funnelchat-php",
    "description": "Official PHP SDK for the Funnelchat public API: contacts, messages, templates, forms, groups, numbers and webhooks.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://developers-portal.funnelchat.app/docs/",
    "support": {
        "email": "soporte@funnelchat.com",
        "docs": "https://developers-portal.funnelchat.app/docs/",
        "issues": "https://github.com/Funnelchat20/funnelchat-php/issues",
        "source": "https://github.com/Funnelchat20/funnelchat-php"
    },
    "keywords": [
        "funnelchat",
        "whatsapp",
        "api",
        "sdk",
        "webhooks",
        "psr-18"
    ],
    "authors": [
        {
            "name": "Funnelchat",
            "email": "soporte@funnelchat.com",
            "homepage": "https://funnelchat.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "The HTTP client the SDK builds by itself, with the timeout applied (Guzzle 7 or 8; any PSR-18 client works)."
    },
    "autoload": {
        "psr-4": {
            "Funnelchat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Funnelchat\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "@php scripts/generate.php",
        "generate:check": "@php scripts/generate.php --check",
        "test": "@php vendor/bin/phpunit",
        "test:e2e": "@php vendor/bin/phpunit --testsuite e2e",
        "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G",
        "cs": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "@php vendor/bin/php-cs-fixer fix",
        "check": [
            "@generate:check",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "generate": "Regenerates src/Generated and src/Resources from spec/ (with --spec <file>, imports a new spec).",
        "generate:check": "Fails if the generated code is not up to date with spec/.",
        "test": "PHPUnit, with no network and no keys.",
        "test:e2e": "The end-to-end tests against funnelchat-sandbox (FUNNELCHAT_SANDBOX_URL=http://127.0.0.1:4010).",
        "analyse": "PHPStan at the max level.",
        "cs": "PHP-CS-Fixer in check mode.",
        "cs:fix": "PHP-CS-Fixer: applies the format.",
        "check": "All of the above, in order."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
